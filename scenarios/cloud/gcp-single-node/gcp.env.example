# Authentication
# Recommended: authenticate with gcloud or GOOGLE_APPLICATION_CREDENTIALS.
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Infrastructure
GCP_CLUSTER_NAME=productive-k3s-gcp
GCP_MACHINE_TYPE=e2-standard-4
GCP_BOOT_DISK_SIZE_GB=80
GCP_SSH_USER=ubuntu
GCP_SSH_PUBLIC_KEY_PATH=/absolute/path/to/id_ed25519.pub
GCP_SSH_PRIVATE_KEY_PATH=/absolute/path/to/id_ed25519
GCP_SSH_ALLOWED_CIDR=0.0.0.0/0
GCP_HTTP_ALLOWED_CIDR=0.0.0.0/0
GCP_API_ALLOWED_CIDR=0.0.0.0/0

# Optional network overrides
GCP_NETWORK=default
GCP_SUBNETWORK=
GCP_IMAGE_PROJECT=ubuntu-os-cloud
GCP_IMAGE_FAMILY=ubuntu-2404-lts-amd64

# Hostnames and remote path
GCP_BASE_DOMAIN=k3s.lab.internal
GCP_RANCHER_HOST=rancher.k3s.lab.internal
GCP_REGISTRY_HOST=registry.k3s.lab.internal
GCP_REMOTE_DIR=/home/ubuntu/productive-k3s-core

# productive-k3s bundle source
PRODUCTIVE_K3S_SOURCE=remote
PRODUCTIVE_K3S_VERSION=0.9.5
PRODUCTIVE_K3S_RELEASE_REPO=productive-k3s/productive-k3s-core
